<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@android:color/transparent">
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_notification_grey"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Screen Orientation"
            android:textColor="#E2E2E2"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btn_orient_portrait"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Portrait"
                android:textColor="#C1C1C1"
                android:textSize="13sp"
                android:gravity="center"
                android:background="@drawable/bg_notification_button"
                android:layout_marginEnd="6dp" />
            <TextView
                android:id="@+id/btn_orient_land_right"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Land. Right"
                android:textColor="#C1C1C1"
                android:textSize="13sp"
                android:gravity="center"
                android:background="@drawable/bg_notification_button"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">
            <TextView
                android:id="@+id/btn_orient_land_left"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Land. Left"
                android:textColor="#C1C1C1"
                android:textSize="13sp"
                android:gravity="center"
                android:background="@drawable/bg_notification_button"
                android:layout_marginEnd="6dp" />
            <TextView
                android:id="@+id/btn_orient_upside"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:text="Upside Down"
                android:textColor="#C1C1C1"
                android:textSize="13sp"
                android:gravity="center"
                android:background="@drawable/bg_notification_button"
                android:layout_marginStart="6dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
